{
  "name": "high-tide-qa-automation",
  "version": "0.1.0",
  "private": true,
  "description": "High Tide QA automation (Playwright): frontend smoke/regression and storefront API checks",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test --project=api",
    "test:frontend": "playwright test --project=desktop-chrome --project=mobile-chrome",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6"
  }
}
